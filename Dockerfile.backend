FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy backend dependencies
COPY v2_api/requirements.txt ./v2_api_requirements.txt

# Install dependencies, adding pandas and requests since tracker/api import them
RUN pip install --no-cache-dir -r v2_api_requirements.txt pandas requests openpyxl

# Copy application files
COPY . .

# Expose backend port
EXPOSE 8000

# Default command runs the Uvicorn server (can be overridden in docker-compose)
CMD ["uvicorn", "v2_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
